# Django YouTube Tools - Environment Variables Configuration
# Copy this file to .env and fill in your actual values

# =============================================================================
# DJANGO SETTINGS
# =============================================================================

# Secret key for Django (REQUIRED)
# Generate a new one with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=your-secret-key-here-change-this-in-production

# Debug mode (REQUIRED)
# Set to False in production
DEBUG=True

# Allowed hosts (REQUIRED)
# Comma-separated list of allowed hostnames
# Example: localhost,127.0.0.1,yourdomain.com
ALLOWED_HOSTS=localhost,127.0.0.1

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================

# PostgreSQL Database URL (OPTIONAL - uses SQLite if not provided)
# Format: postgresql://user:password@host:port/database
# Example: postgresql://postgres:password@localhost:5432/youtube_tools
DATABASE_URL=

# =============================================================================
# REDIS & CELERY CONFIGURATION
# =============================================================================

# Redis broker URL for Celery (REQUIRED for background tasks)
# Default: redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0

# Redis result backend for Celery (REQUIRED for task status)
# Default: redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# =============================================================================
# AI SERVICE API KEYS
# =============================================================================

# Gemini AI API Keys (REQUIRED for keyword research)
# Get from: https://makersuite.google.com/app/apikey
# Multiple keys for rotation to avoid rate limits
GEMINI_API_KEY_1=your-gemini-api-key-1
GEMINI_API_KEY_2=your-gemini-api-key-2
GEMINI_API_KEY_3=your-gemini-api-key-3

# Replicate API Token (REQUIRED for thumbnail generation)
# Get from: https://replicate.com/account/api-tokens
REPLICATE_API_TOKEN=your-replicate-api-token

# HuggingFace API Token (OPTIONAL - for alternative AI models)
# Get from: https://huggingface.co/settings/tokens
HF_API_TOKEN=your-huggingface-api-token

# OpenRouter API Key (REQUIRED for content generation)
# Get from: https://openrouter.ai/keys
OPENROUTER_API_KEY=your-openrouter-api-key

# =============================================================================
# IMAGEKIT CONFIGURATION
# =============================================================================

# ImageKit Public Key (REQUIRED for image uploads)
# Get from: https://imagekit.io/dashboard/developer/api-keys
IMAGEKIT_PUBLIC_KEY=your-imagekit-public-key

# ImageKit Private Key (REQUIRED for image uploads)
IMAGEKIT_PRIVATE_KEY=your-imagekit-private-key

# ImageKit URL Endpoint (REQUIRED for image uploads)
# Format: https://ik.imagekit.io/your_imagekit_id
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_imagekit_id

# =============================================================================
# YOUTUBE API CONFIGURATION
# =============================================================================

# YouTube Data API v3 Key (REQUIRED for video search)
# Get from: https://console.cloud.google.com/apis/credentials
YOUTUBE_API_KEY=your-youtube-api-key

# =============================================================================
# CORS CONFIGURATION
# =============================================================================

# CORS Allowed Origins (OPTIONAL)
# Comma-separated list of allowed origins for CORS
# Example: http://localhost:3000,https://yourdomain.com
CORS_ALLOWED_ORIGINS=http://localhost:3000

# =============================================================================
# NOTES
# =============================================================================

# 1. Never commit the .env file to version control
# 2. Keep your API keys secure and rotate them regularly
# 3. Use different keys for development and production
# 4. Set DEBUG=False in production
# 5. Use strong SECRET_KEY in production
# 6. Configure proper ALLOWED_HOSTS in production
# 7. Use PostgreSQL in production (not SQLite)
# 8. Ensure Redis is running for Celery tasks
# 9. Test all API keys before deploying
# 10. Monitor API usage to avoid rate limits

# =============================================================================
# QUICK START
# =============================================================================

# 1. Copy this file: cp .env.example .env
# 2. Fill in all REQUIRED values
# 3. Generate SECRET_KEY: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
# 4. Get API keys from respective services
# 5. Start Redis: redis-server
# 6. Run migrations: python manage.py migrate
# 7. Create superuser: python manage.py createsuperuser
# 8. Start Celery: celery -A config worker -l info
# 9. Start Django: python manage.py runserver
# 10. Visit: http://localhost:8000

# =============================================================================
# PRODUCTION CHECKLIST
# =============================================================================

# [ ] Set DEBUG=False
# [ ] Generate new SECRET_KEY
# [ ] Configure ALLOWED_HOSTS
# [ ] Use PostgreSQL DATABASE_URL
# [ ] Use production Redis instance
# [ ] Rotate all API keys
# [ ] Enable HTTPS
# [ ] Configure proper CORS origins
# [ ] Set up monitoring and logging
# [ ] Configure backup strategy
# [ ] Test all features thoroughly
